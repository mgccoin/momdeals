# Public base URL of the Express API (port 3003). When deployed to Vercel,
# set this to the Cloudflare tunnel URL (e.g. https://api.momdeals.org).
# In dev, set it to http://localhost:3003.
MOMDEALS_API_BASE=http://localhost:3003

# Blog ID to scope the feed to (Amazon Deals & Coupons)
MOMDEALS_BLOG_ID=32a02390-f0a0-4639-9a98-8ed94b9fe4c8

# Public URL of THIS site (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://momdeals.org

# Amazon Associates tag
NEXT_PUBLIC_AMAZON_TAG=momsdeals07-20

# Shared secret for /api/revalidate (set the same value in Vercel + the Express server)
REVALIDATE_SECRET=change-me-to-a-long-random-string
